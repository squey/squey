<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Makes the process ANSI code page UTF-8.

  Paths travel through the code base as UTF-8 in QString/std::string, but the
  narrow C and Win32 file APIs (fopen, opendir, stat, remove, _popen, ...)
  decode char* using the process ANSI code page, which is a legacy code page by
  default. Every path holding a non-ASCII character was therefore looked up at a
  mangled location: the pcap import silently wrote its split captures nowhere
  when the temporary directory contained one (the CI deliberately uses "Squëy"
  to cover this), and tshark was then handed an invalid stdin.

  Declaring the code page here fixes all those call sites at once instead of
  auditing them one by one. The Universal CRT this build links against honours
  it. Requires Windows 10 1903 or later.

  The activeCodePage element is only recognised in the namespace below.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>

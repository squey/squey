{# The command and the finish-args come from buildstream/files/flatpak/finish_args.sh,
   the runtime version from buildstream/app.yml. -#}
app-id: org.squey.Squey
runtime: org.freedesktop.Platform
runtime-version: '{{runtime_version}}'
sdk: org.freedesktop.Sdk
command: {{command}}
finish-args:
{{finish_args}}
modules:
  - name: squey
    buildsystem: simple
    build-commands:
      - cp -r files/* /app
    sources:
      - type: archive
        url: https://squey.gitlab.io/squey/squey_flatpak_{{version}}.tar.xz
        sha256: {{sha256}}

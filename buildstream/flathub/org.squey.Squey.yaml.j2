{# Everything but the modules comes from buildstream/files/flatpak/metadata.sh, and the
   runtime version from buildstream/app.yml. -#}
app-id: {{app_id}}
runtime: {{runtime}}
runtime-version: '{{runtime_version}}'
sdk: {{sdk}}
command: {{command}}
finish-args:
{{finish_args}}
modules:
  - name: squey
    buildsystem: simple
    build-commands:
      - cp -r files/* /app
    sources:
      - type: archive
        url: https://squey.gitlab.io/squey/squey_flatpak_{{version}}.tar.xz
        sha256: {{sha256}}

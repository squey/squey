Export the OpenCL entrypoints from the mingw build of libpocl

pocl.dll exports no symbol at all, so the Khronos loader drops it with "failed
to get function address clGetExtensionFunctionAddress" and the application
silently falls back to its non-OpenCL rendering path. Three things line up
against mingw:

 - POCL_EXPORT resolves to __attribute__((visibility("default"))) whenever
   __GNUC__ is defined, and visibility attributes mean nothing in PE/COFF, so
   nothing is marked dllexport;
 - EXPORT_POCL_LIB, which selects the __declspec form, is only defined for MSVC;
 - mingw takes the ELF naming path, where entrypoints are named POcl* and the
   plain cl* names come from symbol aliases -- which PE does not have, so the
   plain names never exist.

Meanwhile --exclude-libs,ALL keeps the archives' symbols out of the export
table, which leaves nothing at all. Take the Windows path for naming and
__declspec on any _WIN32 target, and define EXPORT_POCL_LIB for mingw too. Only
the entrypoints are exported, so --exclude-libs still hides the LLVM symbols.
diff --git a/include/pocl_export.h b/include/pocl_export.h
index 01c368be..a67f1bce 100644
--- a/include/pocl_export.h
+++ b/include/pocl_export.h
@@ -24,7 +24,15 @@
 #ifndef POCL_EXPORT_H
 #define POCL_EXPORT_H
 
-#if defined(__GNUC__) && (__GNUC__ > 4 || __GNUC__ == 4 && __GNUC_MINOR__ >= 1)
+#if defined(_WIN32)
+#  if defined(EXPORT_POCL_LIB)
+#    define POCL_EXPORT __declspec (dllexport)
+#  elif defined(IMPORT_POCL_LIB)
+#    define POCL_EXPORT __declspec (dllimport)
+#  else
+#    define POCL_EXPORT
+#  endif
+#elif defined(__GNUC__) && (__GNUC__ > 4 || __GNUC__ == 4 && __GNUC_MINOR__ >= 1)
 #  define POCL_EXPORT __attribute__ ((visibility ("default")))
 #elif defined(_MSC_VER)
 #  if defined(EXPORT_POCL_LIB)
diff --git a/lib/CL/CMakeLists.txt b/lib/CL/CMakeLists.txt
index e18427cc..2684dcf3 100644
--- a/lib/CL/CMakeLists.txt
+++ b/lib/CL/CMakeLists.txt
@@ -260,7 +260,7 @@ else()
 endif()
 
 add_library("pocl_cache" OBJECT "pocl_cache.c")
-if(BUILD_SHARED_LIBS AND MSVC)
+if(BUILD_SHARED_LIBS AND (MSVC OR MINGW))
   # Inject __declspec(dllexport).
   target_compile_definitions("pocl_cache" PRIVATE EXPORT_POCL_LIB)
   target_compile_definitions("pocl_cache" INTERFACE IMPORT_POCL_LIB)
@@ -319,7 +319,7 @@ if (ENABLE_LLVM)
     endif()
   endif()
 
-  if(BUILD_SHARED_LIBS AND MSVC)
+  if(BUILD_SHARED_LIBS AND (MSVC OR MINGW))
     # Inject __declspec(dllexport).
     target_compile_definitions(lib_cl_llvm PRIVATE EXPORT_POCL_LIB)
     target_compile_definitions(lib_cl_llvm INTERFACE IMPORT_POCL_LIB)
@@ -359,7 +359,7 @@ add_library("libpocl_unlinked_objs" OBJECT ${POCL_LIB_SOURCES})
 target_include_directories(libpocl_unlinked_objs
   PRIVATE ${CMAKE_SOURCE_DIR}/thirdparty/STC/include)
 
-if(BUILD_SHARED_LIBS AND MSVC)
+if(BUILD_SHARED_LIBS AND (MSVC OR MINGW))
   # Inject __declspec(dllexport).
   target_compile_definitions(libpocl_unlinked_objs PRIVATE EXPORT_POCL_LIB)
   target_compile_definitions(libpocl_unlinked_objs INTERFACE IMPORT_POCL_LIB)
@@ -439,7 +439,7 @@ set(POCL_TRANSITIVE_LIBS ${POCL_PRIVATE_LINK_LIST} PARENT_SCOPE)
 #################################################################
 
 add_library("${POCL_LIBRARY_NAME}" ${LIBPOCL_OBJS})
-if(BUILD_SHARED_LIBS AND MSVC)
+if(BUILD_SHARED_LIBS AND (MSVC OR MINGW))
   # Inject __declspec(dllexport).
   target_compile_definitions("${POCL_LIBRARY_NAME}" PRIVATE EXPORT_POCL_LIB)
   target_compile_definitions("${POCL_LIBRARY_NAME}" INTERFACE IMPORT_POCL_LIB)
diff --git a/lib/CL/pocl_cl.h b/lib/CL/pocl_cl.h
index 21dabd67..9926d50c 100644
--- a/lib/CL/pocl_cl.h
+++ b/lib/CL/pocl_cl.h
@@ -281,8 +281,9 @@ extern pocl_obj_id_t last_object_id;
 #  define POsym(name)
 #  define POsymAlways(name)
 
-#elif defined(_WIN32) && !defined(__MINGW32__)
-/* Visual Studio does not support this magic either */
+#elif defined(_WIN32)
+/* Neither Visual Studio nor mingw supports this magic: PE has no ELF-style
+ * symbol aliases, so the entrypoints keep their plain OpenCL names. */
 #  define POname(name) name
 #  define POdeclsym(name)
 #  define POdeclsymExport(name)

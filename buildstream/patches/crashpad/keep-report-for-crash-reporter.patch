index 1d9f826..36d4a9b 100644
--- a/handler/mac/crash_report_exception_handler.cc
+++ b/handler/mac/crash_report_exception_handler.cc
@@ -236,7 +236,7 @@ kern_return_t CrashReportExceptionHandler::CatchMachException(
     }
 
     if (has_crash_reporter && uploads_enabled) {
-      database_->DeleteReport(uuid);
+      // The report is kept in the database for the crash reporter to pick up.
     } else if (upload_thread_) {
       if (wait_for_upload_) {
         upload_thread_->ReportPendingSync(uuid);
